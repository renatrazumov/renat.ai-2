# Client (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional aliases used by /api/chat
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Prefer Netlify AI Gateway in production (no key needed after first deploy).
# Optional OpenRouter fallback for local parity with the prior live chat path:
OPENROUTER_API_KEY=

# Optional model override
RENAT_CHAT_MODEL=
